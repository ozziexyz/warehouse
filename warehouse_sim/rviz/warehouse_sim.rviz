Panels:
  - Class: rviz_common/Displays
    Help Height: 104
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1
        - /Odometry1
        - /Image1
        - /PoseWithCovariance1
      Splitter Ratio: 0.5
    Tree Height: 144
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
