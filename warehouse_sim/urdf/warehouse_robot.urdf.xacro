<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Absolute path to the controller manager config, supplied by the launch file -->
  <xacro:arg name="controller_config_path" default=""/>

  <!-- Chassis -->
  <xacro:property name="base_length" value="0.75"/>
  <xacro:property name="base_width" value="0.65"/>
  <xacro:property name="base_height" value="0.25"/>
  <xacro:property name="base_mass" value="16.0"/>

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.13"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_mass" value="0.75"/>

  <!-- Caster wheels -->
  <xacro:property name="caster_radius" value="0.065"/>
  <xacro:property name="caster_mass" value="0.2"/>

  <!-- Cargo cage: thin walls around the chassis, front wall has a hinged flap -->
  <xacro:property name="cage_wall_height" value="1.0"/>
  <xacro:property name="cage_wall_thickness" value="0.02"/>
  <xacro:property name="cage_flap_height" value="0.5"/>
  <xacro:property name="cage_wall_mass" value="0.5"/>
  <xacro:property name="cage_flap_mass" value="0.3"/>

  <!-- Cage floor: doubles as an ejector belt (gz-sim TrackController) -->
  <xacro:property name="cage_floor_thickness" value="0.01"/>
  <xacro:property name="cage_floor_mass" value="0.4"/>

  <!-- Rear RGB camera -->
  <xacro:property name="camera_size" value="0.04"/>
  <xacro:property name="camera_mass" value="0.05"/>

  <!-- Bottom-facing camera, for reading floor AprilTags -->
  <xacro:property name="bottom_camera_size" value="0.03"/>
  <xacro:property name="bottom_camera_mass" value="0.03"/>
  <!-- Height of the lens above the floor: bigger gap widens the footprint the camera
       sees on the ground, so a tag stays in frame longer as the robot drives over it -->
  <xacro:property name="bottom_camera_ground_gap" value="0.043"/>

  <!-- Front 2D lidar -->
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.06"/>
  <xacro:property name="lidar_mass" value="0.15"/>

  <!-- IMU -->
  <xacro:property name="imu_size" value="0.02"/>
  <xacro:property name="imu_mass" value="0.01"/>

  <!-- Derived placement offsets -->
  <xacro:property name="ground_clearance" value="0.04"/>
  <xacro:property name="base_z" value="${wheel_radius + ground_clearance}"/>
  <xacro:property name="wheel_z_offset" value="${wheel_radius - base_z}"/>
  <xacro:property name="caster_z_offset" value="${caster_radius - base_z}"/>
  <xacro:property name="caster_x_offset" value="${base_length / 2 - caster_radius - 0.02}"/>
  <xacro:property name="bottom_camera_z_offset" value="${bottom_camera_ground_gap + bottom_camera_size/2 - base_z}"/>
  <xacro:property name="cage_base_z" value="${base_height / 2.0}"/>
  <xacro:property name="cage_front_upper_height" value="${cage_wall_height - cage_flap_height}"/>
  <xacro:property name="cage_floor_length" value="${base_length - 2*cage_wall_thickness}"/>
  <xacro:property name="cage_floor_width" value="${base_width - 2*cage_wall_thickness}"/>

  <material name="body_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="caster_silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="cage_yellow">
    <color rgba="0.9 0.7 0.1 1.0"/>
  </material>

  <!-- base_footprint sits on the ground and is the robot's control/odometry origin -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass / 12.0 * (base_width*base_width + base_height*base_height)}" ixy="0" ixz="0"
        iyy="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}" iyz="0"
        izz="${base_mass / 12.0 * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- Driven wheel: mounted on the left/right sides, midway along the chassis -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" iyz="0"
          izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * (base_width/2 + wheel_width/2)} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- Caster wheel: unpowered, frictionless sphere for front/back support -->
  <xacro:macro name="caster_wheel" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_silver"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia
          ixx="${2.0/5.0 * caster_mass * caster_radius*caster_radius}" ixy="0" ixz="0"
          iyy="${2.0/5.0 * caster_mass * caster_radius*caster_radius}" iyz="0"
          izz="${2.0/5.0 * caster_mass * caster_radius*caster_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x_offset} 0 ${caster_z_offset}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster_wheel prefix="front" x_offset="${caster_x_offset}"/>
  <xacro:caster_wheel prefix="back" x_offset="${-caster_x_offset}"/>

  <!-- Fixed cage wall: a thin box sitting on top of the chassis -->
  <xacro:macro name="cage_wall" params="name size_x size_y size_z origin_x origin_y origin_z">
    <link name="${name}_wall_link">
      <visual>
        <geometry>
          <box size="${size_x} ${size_y} ${size_z}"/>
        </geometry>
        <material name="cage_yellow"/>
      </visual>
      <collision>
        <geometry>
          <box size="${size_x} ${size_y} ${size_z}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${cage_wall_mass}"/>
        <inertia
          ixx="${cage_wall_mass / 12.0 * (size_y*size_y + size_z*size_z)}" ixy="0" ixz="0"
          iyy="${cage_wall_mass / 12.0 * (size_x*size_x + size_z*size_z)}" iyz="0"
          izz="${cage_wall_mass / 12.0 * (size_x*size_x + size_y*size_y)}"/>
      </inertial>
    </link>

    <joint name="${name}_wall_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wall_link"/>
      <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_wall_link">
      <material>Gazebo/Yellow</material>
    </gazebo>
  </xacro:macro>

  <xacro:cage_wall name="back"
    size_x="${cage_wall_thickness}" size_y="${base_width}" size_z="${cage_wall_height}"
    origin_x="${-(base_length/2 - cage_wall_thickness/2)}" origin_y="0"
    origin_z="${cage_base_z + cage_wall_height/2}"/>

  <xacro:cage_wall name="left"
    size_x="${base_length}" size_y="${cage_wall_thickness}" size_z="${cage_wall_height}"
    origin_x="0" origin_y="${base_width/2 - cage_wall_thickness/2}"
    origin_z="${cage_base_z + cage_wall_height/2}"/>

  <xacro:cage_wall name="right"
    size_x="${base_length}" size_y="${cage_wall_thickness}" size_z="${cage_wall_height}"
    origin_x="0" origin_y="${-(base_width/2 - cage_wall_thickness/2)}"
    origin_z="${cage_base_z + cage_wall_height/2}"/>

  <!-- Front wall: fixed upper section plus a hinged flap covering the bottom cage_flap_height -->
  <xacro:cage_wall name="front_upper"
    size_x="${cage_wall_thickness}" size_y="${base_width}" size_z="${cage_front_upper_height}"
    origin_x="${base_length/2 - cage_wall_thickness/2}" origin_y="0"
    origin_z="${cage_base_z + cage_flap_height + cage_front_upper_height/2}"/>

  <!-- Front flap: hinged at its bottom edge, folds down/outward to open like a tailgate -->
  <link name="front_flap_link">
    <visual>
      <origin xyz="0 0 ${cage_flap_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${cage_wall_thickness} ${base_width} ${cage_flap_height}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${cage_flap_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${cage_wall_thickness} ${base_width} ${cage_flap_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${cage_flap_height/2}" rpy="0 0 0"/>
      <mass value="${cage_flap_mass}"/>
      <inertia
        ixx="${cage_flap_mass / 12.0 * (base_width*base_width + cage_flap_height*cage_flap_height)}" ixy="0" ixz="0"
        iyy="${cage_flap_mass / 12.0 * (cage_wall_thickness*cage_wall_thickness + cage_flap_height*cage_flap_height)}" iyz="0"
        izz="${cage_flap_mass / 12.0 * (cage_wall_thickness*cage_wall_thickness + base_width*base_width)}"/>
    </inertial>
  </link>

  <joint name="front_flap_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_flap_link"/>
    <origin xyz="${base_length/2 - cage_wall_thickness/2} 0 ${cage_base_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 0 = closed (vertical), pi/2 = fully open (folded flat outward) -->
    <limit lower="0" upper="${pi/2}" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <gazebo reference="front_flap_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Cage floor: sits on the chassis roof inside the cage walls. It's also the ejector
       belt surface — TrackController drives its contact velocity to push cargo resting
       on it out through the (opened) front flap. -->
  <link name="cage_floor_link">
    <visual>
      <geometry>
        <box size="${cage_floor_length} ${cage_floor_width} ${cage_floor_thickness}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cage_floor_length} ${cage_floor_width} ${cage_floor_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${cage_floor_mass}"/>
      <inertia
        ixx="${cage_floor_mass / 12.0 * (cage_floor_width*cage_floor_width + cage_floor_thickness*cage_floor_thickness)}" ixy="0" ixz="0"
        iyy="${cage_floor_mass / 12.0 * (cage_floor_length*cage_floor_length + cage_floor_thickness*cage_floor_thickness)}" iyz="0"
        izz="${cage_floor_mass / 12.0 * (cage_floor_length*cage_floor_length + cage_floor_width*cage_floor_width)}"/>
    </inertial>
  </link>

  <joint name="cage_floor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cage_floor_link"/>
    <origin xyz="0 0 ${cage_base_z + cage_floor_thickness/2}" rpy="0 0 0"/>
  </joint>

  <!-- Fixed joints get lumped into their parent by the URDF->SDF conversion, which would
       merge cage_floor_link into base_link and leave TrackController nothing to reference -->
  <gazebo reference="cage_floor_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>

  <gazebo reference="cage_floor_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <!-- Perpendicular to the belt's travel direction (link +x, toward the flap), so
         TrackController has a well-defined friction axis to apply drive velocity along -->
    <fdir1>0 1 0</fdir1>
  </gazebo>

  <!-- Front lidar: centered on the chassis front face, below the cage, so half the puck
       sticks out past the front edge -->
  <link name="front_lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass / 12.0 * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}" ixy="0" ixz="0"
        iyy="${lidar_mass / 12.0 * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}" iyz="0"
        izz="${lidar_mass / 2.0 * lidar_radius*lidar_radius}"/>
    </inertial>
  </link>

  <joint name="front_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_lidar_link"/>
    <origin xyz="${base_length/2} 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="front_lidar" type="gpu_lidar">
      <lidar>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>${-2.0/3.0*pi}</min_angle>
            <max_angle>${2.0/3.0*pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>front_lidar</topic>
    </sensor>
  </gazebo>

  <!-- Rear camera: mounted flush on the chassis back face, pointing straight out along -x -->
  <link name="rear_camera_link">
    <visual>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <inertia
        ixx="${camera_mass / 6.0 * camera_size*camera_size}" ixy="0" ixz="0"
        iyy="${camera_mass / 6.0 * camera_size*camera_size}" iyz="0"
        izz="${camera_mass / 6.0 * camera_size*camera_size}"/>
    </inertial>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="${-(base_length/2 + camera_size/2)} 0 0" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Optical frame: REP 103 convention (Z forward, X right, Y down), used for image/camera_info -->
  <link name="rear_camera_optical_frame"/>

  <joint name="rear_camera_optical_joint" type="fixed">
    <parent link="rear_camera_link"/>
    <child link="rear_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="rear_camera_link">
    <material>Gazebo/Black</material>
    <sensor name="rear_camera" type="camera">
      <camera>
        <horizontal_fov>1.4</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
        <!-- Sensor is aimed straight out the back for now; revisit if the mount angle changes -->
        <optical_frame_id>rear_camera_optical_frame</optical_frame_id>
      </camera>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>rear_camera</topic>
    </sensor>
  </gazebo>

  <!-- Bottom camera: flush on the chassis underside, centered, pointing straight down
       through the ground clearance gap to read floor AprilTags -->
  <link name="bottom_camera_link">
    <visual>
      <geometry>
        <box size="${bottom_camera_size} ${bottom_camera_size} ${bottom_camera_size}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${bottom_camera_size} ${bottom_camera_size} ${bottom_camera_size}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${bottom_camera_mass}"/>
      <inertia
        ixx="${bottom_camera_mass / 6.0 * bottom_camera_size*bottom_camera_size}" ixy="0" ixz="0"
        iyy="${bottom_camera_mass / 6.0 * bottom_camera_size*bottom_camera_size}" iyz="0"
        izz="${bottom_camera_mass / 6.0 * bottom_camera_size*bottom_camera_size}"/>
    </inertial>
  </link>

  <joint name="bottom_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bottom_camera_link"/>
    <origin xyz="0 0 ${bottom_camera_z_offset}" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="bottom_camera_optical_frame"/>

  <joint name="bottom_camera_optical_joint" type="fixed">
    <parent link="bottom_camera_link"/>
    <child link="bottom_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="bottom_camera_link">
    <material>Gazebo/Black</material>
    <sensor name="bottom_camera" type="camera">
      <camera>
        <horizontal_fov>1.9</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <!-- Lens sits only a couple cm off the floor, so the near plane has to be tiny -->
          <near>0.005</near>
          <far>1.0</far>
        </clip>
        <optical_frame_id>bottom_camera_optical_frame</optical_frame_id>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>bottom_camera</topic>
    </sensor>
  </gazebo>

  <!-- IMU: mounted at the chassis origin -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia
        ixx="${imu_mass / 6.0 * imu_size*imu_size}" ixy="0" ixz="0"
        iyy="${imu_mass / 6.0 * imu_size*imu_size}" iyz="0"
        izz="${imu_mass / 6.0 * imu_size*imu_size}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <!-- ros2_control: the two driven wheels plus the front cage flap are actuated -->
  <ros2_control name="warehouse_robot_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_flap_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config_path)</parameters>
    </plugin>
  </gazebo>

  <!-- Ejector belt: velocity-only, commanded over gz transport (not ros2_control) on
       /model/warehouse_robot/link/cage_floor_link/track_cmd_vel, bridged to ROS in
       sim.launch.py. Positive velocity pushes cargo out the front (+x, flap side). -->
  <gazebo>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>cage_floor_link</link>
      <odometry_publish_frequency>10</odometry_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Ground-truth pose for testing: publishes only the robot model's pose (no links/
       sensors/collisions) to /model/warehouse_robot/pose, bridged to ROS in sim.launch.py -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

</robot>
